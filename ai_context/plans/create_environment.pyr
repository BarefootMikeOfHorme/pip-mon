{
  "plan_id": "create_environment",
  "task": "Bring the test environment into existence: at least one authored record in PipMonTestFacility.esp, written by headless xEdit and read back by an independent validator.",
  "goal": "At least one authored record in PipMonTestFacility.esp, written by headless xEdit and read back by an independent validator.",
  "side": "creation-kit",
  "surfaces": [
    "creation.xedit",
    "creation.ck",
    "surfaces_gate"
  ],
  "requires": [],
  "determinism": {
    "idempotent": true,
    "ordering": "Validate BEFORE generating. A generator whose output cannot be read back is not producing an environment, it is producing a file. Then fix the load path, then fix the generator, then generate. Reordering these means debugging two unknowns at once, which is exactly how the last three attempts produced no evidence at all.",
    "no_implicit_state": "Assumes xEdit 4.1.5f x64 is present and its first-run notice has been dismissed by a human. Assumes the curated 35-plugin load order is active. Assumes NO xEdit process is running -- enforced as a precondition, not hoped for."
  },
  "gate_repair_2026_09_30": "Eight actions and gates in this plan were prose, not commands, and the orchestrator's allowlist refuses anything that is not a command. A dry run on 2026-09-30 listed all eight: P2's two actions and its verify, P3's second verify, P4's action and both its verifies. So P2, P3 and P4 could not have passed for any reason relating to xEdit. Every one is now a real command, and tools/xedit_log.py exists because three of them were asking questions about a log that nothing could measure. P4's verify was also repaired the same way: it named --require report, which resolved to the VALIDATOR's report, so the generator phase would have passed on a stale file from another job. xedit_log.py now takes --report and --gen-key so the two artefacts cannot be confused.",
  "preflight": [
    {
      "check": "no xEdit process is running",
      "run": "Get-Process xFOEdit64",
      "expect": "zero processes",
      "why": "A leaked process from an earlier async launch held the instance lock for 191 minutes and silently blocked every later run. This is the single most likely reason a run produces no evidence."
    },
    {
      "check": "no Creation Kit is running",
      "run": "Get-Process CreationKit",
      "expect": "zero processes",
      "why": "Two engines writing the same Data folder is the failure this project refuses to risk."
    }
  ],
  "phases": [
    {
      "id": "P1",
      "name": "prove the headless load actually loads",
      "purpose": "Establish that xEdit reaches and starts our script, BEFORE any generator work. Measured 2026-09-30 20:11: the loader finished and the script started, so this phase now passes.",
      "preconditions": [
        "preflight clean"
      ],
      "actions": [
        {
          "run": "tools/validate_plugin.ps1 -Async",
          "expect_exit": 0,
          "detach": true,
          "why": "Detached, and the orchestrator is told so explicitly. Invoked any other way it WAITS: subprocess.run blocks on it, so on 2026-09-30 the orchestrator sat ~3 minutes inside a call that was supposed to return instantly, and the caller could neither see nor interrupt anything. The -Async flag alone is not enough; the launch has to be spawned, not waited on."
        }
      ],
      "verify": [
        {
          "gate": "tools/xedit_log.py --require loader",
          "expect_exit": 0,
          "why": "The background loader finished. This is the load path working, and it is a measurement rather than a hope."
        },
        {
          "gate": "tools/xedit_log.py --require script",
          "expect_exit": 0,
          "why": "The script was picked up and began applying. Replaces the old prose gate 'advanced past Loading active plugin list', which was not a command and could never run."
        }
      ],
      "poll": {
        "run": "tools/validate_plugin.ps1 -Collect",
        "in_flight_exit": 4,
        "interval": 20,
        "budget_sec": 40,
        "why": "A detached launch is not done when it returns. Exit 4 means still loading, which is the NORMAL state for the first two minutes. The budget is deliberately short so the orchestrator returns and the caller stays free -- being locked inside a long process is the one failure mode that makes everything else unobservable. Override with --budget."
      },
      "on_failure": {
        "stop": true,
        "rollback": [
          "Stop-Process -Name xFOEdit64 -Force",
          "rm runs/watch/xedit-job.json"
        ],
        "report": "The headless load did not complete. Do NOT proceed. Run tools/xedit_log.py --json and read the last lines of FO4Script_log.txt: the failure mode differs between a hidden window, an unanswered dialog, and a script that aborts, and those need different fixes."
      }
    },
    {
      "id": "P2",
      "name": "confirm the script reaches Finalize",
      "purpose": "Separate 'xEdit could not load' from 'the script ran and failed'. These are different bugs with different fixes. Finalize is provable only by its effect, which is the report it writes.",
      "preconditions": [
        "P1 verify passed"
      ],
      "actions": [
        {
          "run": "tools/validate_plugin.ps1 -Collect",
          "expect_exit": 0,
          "why": "Reaps the finished job and reports. Replaces the old prose action 'read stdout for AddMessage output', which was not a command."
        }
      ],
      "verify": [
        {
          "gate": "tools/xedit_log.py --require report",
          "expect_exit": 0,
          "why": "The report is the proof, and its absence is the whole problem this phase exists to solve. A report cannot be written by a script that never reached Finalize, so this one gate covers what the old three prose gates were reaching for."
        }
      ],
      "on_failure": {
        "stop": true,
        "rollback": [],
        "report": "The script loaded and started but did not reach Finalize. MEASURED 2026-09-30 20:11: abort at UserScript line 106, [EAbort], 15s after the script started, report absent, no new exception-log entry. Line 106 is inside Process, at the per-record attribution using GetFile/GetFileName. The previous revision deliberately did NOT attempt per-plugin attribution for exactly this reason; see the header of the .psc. Fix the script, do not re-run to confirm it is broken."
      }
    },
    {
      "id": "P3",
      "name": "make the generator addressable",
      "purpose": "Remove API calls that do not exist, and confront the group-addressing gap honestly rather than guessing at it.",
      "preconditions": [
        "P2 verify passed"
      ],
      "actions": [
        {
          "run": "tools/artifact_gate.py",
          "expect_exit": 0,
          "why": "The gate must be clean of gen_facility errors before the generator is trusted to run."
        }
      ],
      "verify": [
        {
          "gate": "tools/check_item.py testfacility/xedit/gen_facility.pas",
          "expect_exit": 0,
          "why": "Per-file application of the spec rules. Replaces the prose gate 'no GetActivePlugin or AddNewElement in testfacility/xedit/', which searched a path rather than running a check."
        },
        {
          "gate": "tools/check_item.py testfacility/xedit/validate_plugin.pas",
          "expect_exit": 0,
          "why": "Same rules, on the validator. A gate that only covers the generator leaves the script that runs it ungated, and that script is the one that decides every verdict."
        }
      ],
      "on_failure": {
        "stop": true,
        "rollback": [
          "git checkout testfacility/xedit/"
        ],
        "report": "A source file calls something this xEdit build does not have. Correct it against ai_context/spec/xedit_api.json, which is transcribed from the upstream signatures. Note that a name being ABSENT from that spec is not the same as being proven absent -- GetFile, FileCount, MasterCount and MasterByIndex are used by our validator and have no spec entry yet, which is a gap in the spec, not a clearance."
      }
    },
    {
      "id": "P4",
      "name": "generate one record",
      "purpose": "Create the smallest thing that proves the pipeline end to end: one CELL, nothing else.",
      "preconditions": [
        "P3 verify passed"
      ],
      "placement_requirements_2026_10_01": {
        "note": "Discovered while repairing the Papyrus test scripts. NOT yet done in the CK, so the cell this plan builds will not be playable until it is. Each item is a placement instruction, not a code change.",
        "PipMon_LoopTest": "Scriptname is now 'extends ObjectReference', because self.GetFormID() is the only way to report a FormID and it requires a real static type on self -- a bare Scriptname self is a ScriptObject that cannot be cast to ObjectReference and has no GetFormID. Cost of the fix: the CK must ATTACH this script to an object in the cell rather than leave it on the quest. It also needs a value for its AbortRequested property to be settable from the console.",
        "PipMon_LeakTest": "Needs ObjectReference properties ActorSettler, ActorRaider and Workbench assigned to placed objects in the cell. Every one of them is optional at runtime -- the tick falls through Workbench -> ActorSettler -> ActorRaider and skips if all are none -- but with none assigned the test spawns nothing and reports a healthy zero, which is a false pass. Assign at least one.",
        "PipMon_TerminalTest": "Unchanged placement. Property-dispatched from OnMenuOpenCloseEvent via its own action property, same pattern as the other two."
      },
      "capability_gaps_2026_10_01": {
        "note": "Real absences found by compiling against PapyrusCompiler 2.8.0.4, not by reading documentation. Both are recorded so a future attempt does not re-litigate them as typos. Neither blocks P4; both block parts of the test scripts' stated purpose.",
        "no_script_thread_spawn": "SpawnThreadFromCustomEvent does not exist in FO4 Papyrus -- it is SKSE. NO script can start a second thread. This is a missing capability, not a missing wrapper: no spelling works, with or without a (self) argument. Consequence: PipMon_LoopTest cannot exercise the vm_starvation path from script alone, because that needs N>=2 concurrent threads. It now records RequestedThreads and ThreadsSpawned separately so a run reports the gap rather than silently testing N=1 while claiming N. Fixing this needs the native side, so it is Layer A work.",
        "no_script_side_unwind": "self.Cancel() and GetOwningObjectOfThread do not exist either, so a script cannot stop itself. Every termination is therefore recorded as a request (OverseerBridge's RequestTerminate, with TerminationRequests for force and SoftTerminationRequests for unwind) and performed by the native main-thread runner. Also Layer A work."
      },
      "actions": [
        {
          "run": "tools/run_gen.ps1 -Async",
          "expect_exit": 0,
          "detach": true,
          "why": "tools/run_gen.ps1 exists as of 2026-09-30, so this phase is no longer blocked on a missing runner. Detached for the same reason P1 is: invoked any other way the orchestrator waits three minutes and the caller can neither see nor interrupt anything."
        }
      ],
      "poll": {
        "run": "tools/run_gen.ps1 -Collect",
        "in_flight_exit": 4,
        "interval": 20,
        "budget_sec": 60,
        "why": "The generator is slower than the validator: measured 1m42s of script time over 2.29M records, because it walks every record to build its signature counts."
      },
      "verify": [
        {
          "gate": "tools/xedit_log.py --report generator --require report",
          "expect_exit": 0,
          "why": "The GENERATOR's report, named explicitly. The gate used to say --require report, which xedit_log.py resolved to the VALIDATOR's report -- so this phase would have been graded against a leftover file from a different job and passed without the generator ever running."
        },
        {
          "gate": "tools/xedit_log.py --report generator --gen-key",
          "expect_exit": 0,
          "status": "STRICT MODE, and it is a WALL until record creation is proven. Diagnostic mode is what the first run uses -- see the next entry.",
          "why": "The number, not the file. A generator that reaches Finalize and creates nothing is the most likely way this phase reports green while the environment still does not exist, so the gate asks the report for records_created > 0. xedit_log.py gained --report and --gen-key for exactly this: one tool, two artefacts, no silent substitution between them."
        },
        {
          "gate": "tools/xedit_log.py --report generator --gen-key --diagnostic",
          "expect_exit": 3,
          "first_run_only": true,
          "status": "IMPLEMENTED in tools/xedit_log.py on 2026-10-01",
          "why": "This is the gate the FIRST wbCopyElementToFile run must use. The strict gate demands records_created > 0 from a generator that could not create records, so it cannot pass, and a red from it says nothing about whether the create call now works. --diagnostic reports exit 3 (INCONCLUSIVE) when the generator demonstrably ran, wrote a fresh report, and created nothing -- which is the expected shape of a first attempt -- and exit 1 when there is no report or it is unreadable. Exit 3 is deliberately distinct from both 0 and 1 so an inconclusive diagnostic can never be read as a pass or as a real failure. Switch to the strict gate once creation is proven.",
          "stale_report_fixed_2026_10_01": "The strict gate also had a false pass, now closed. The generator report is a file on disk that survives between runs, and survey() already computed a stale flag from --stale-after that the --gen-key branch never consulted. So a records_created=5 report from a PREVIOUS job would have turned P4 green without this run creating anything -- the precise failure this gate exists to prevent. The branch now refuses a report older than --stale-after outright. Verified: a backdated positive report is refused with exit 1, a fresh one passes with exit 0."
        }
      ],
      "on_failure": {
        "stop": true,
        "rollback": [
          "restore runs/tasks/facility-v0/snapshots/PRIOR-WORK-973B.esp"
        ],
        "report": "The generator did not produce a report. Run tools/xedit_log.py and read the exception log: the previous version of gen_facility.pas died on AssignFile, which is ordinary Delphi and is NOT available in xEdit's Pascal. That class of fault is a COMPILE failure and only ever appears in xFOEdit64Exception.log."
      },
      "expected_outcome_today": "Both gates are expected to FAIL on the first run, and that is the correct result. gen_facility.pas reaches the plugin and reports; it does not create a CELL, because every link in the group-addressing chain is documented but unproven and an unproven call aborts the run with nothing written. A green P4 means a CELL exists in PipMonTestFacility.esp."
    },
    {
      "id": "P5",
      "name": "prove it in a live game",
      "purpose": "The environment existing on disk is not the environment being usable. This phase needs Layer A.",
      "preconditions": [
        "P4 verify passed",
        "invariant: layer-a is MET"
      ],
      "blocked_reason": "Layer A is NOT_MET. No BSScript vtable slot is hooked, so no Papyrus-to-native call can happen and the facility's probe cannot produce a verdict. This phase cannot start yet and no amount of environment work changes that.",
      "actions": [],
      "verify": [],
      "on_failure": {
        "stop": true,
        "rollback": [],
        "report": "Blocked on Layer A. See ai_context/spec/blockers_to_environment.json item B5."
      }
    }
  ],
  "the_honest_summary": "P1 is measured passing as of 2026-09-30 20:11: the load works and the script starts. P2 is measured FAILING at a named line with a named cause. P3 and P4 were unrunnable until this repair and P4 is still blocked on a runner that does not exist. P5 is blocked on Layer A. A green run of P1 means the pipe is sound; it does not mean anything has ever been validated."
}
